<section class="password">
  <div class="password__logo">{% render 'wordmark' %}</div>
  <p class="statement__big">{{ section.settings.heading | escape }}</p>
  {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}

  {%- form 'customer', class: 'signup signup--center' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
    {%- if form.posted_successfully? -%}
      <p class="signup__done" role="status">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <input type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}" required>
      <button type="submit">{{ 'newsletter.submit' | t }}</button>
    {%- endif -%}
  {%- endform -%}

  <details class="password__entry">
    <summary>Enter with password</summary>
    {%- form 'storefront_password', class: 'signup signup--center' -%}
      <input type="password" name="password" placeholder="Password" aria-label="Password" required>
      <button type="submit">Enter</button>
      {%- if form.errors -%}<p class="signup__error">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Next drop soon." }
  ]
}
{% endschema %}
