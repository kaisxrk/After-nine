{%- liquid
  assign limit = section.settings.limit
  if section.settings.products != blank
    assign items = section.settings.products
  elsif section.settings.collection != blank
    assign items = section.settings.collection.products
  else
    assign items = collections.all.products
  endif
-%}
<section class="products" id="shop">
  <div class="section-head">
    <h2>{{ section.settings.heading | escape }}</h2>
    <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'general.view_all' | t }}</a>
  </div>
  <div class="grid">
    {%- assign shown = 0 -%}
    {%- for product in items -%}
      {%- if shown >= limit -%}{%- break -%}{%- endif -%}
      {%- if section.settings.products == blank -%}
        {%- if product.price_min == 0 -%}{%- continue -%}{%- endif -%}
        {%- if section.settings.hide_sold_out and product.available == false -%}{%- continue -%}{%- endif -%}
      {%- endif -%}
      {% render 'product-card', product: product %}
      {%- assign shown = shown | plus: 1 -%}
    {%- else -%}
      <p class="empty">{{ 'general.no_products' | t }}</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The collection" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 8, "info": "Pick products by hand, or leave empty to use the collection below." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "checkbox", "id": "hide_sold_out", "label": "Hide sold-out products", "default": true, "info": "Applies when products are picked from a collection. Products priced at $0 are always hidden." },
    { "type": "range", "id": "limit", "label": "Number of products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
