{%- assign hero_alt = section.settings.image.alt | default: shop.name -%}
<section class="hero" style="--focal: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;">
  {%- if section.settings.image != blank -%}
    {%- if section.settings.image_mobile != blank -%}
      <picture>
        <source media="(max-width: 800px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }} 900w, {{ section.settings.image_mobile | image_url: width: 1400 }} 1400w" sizes="100vw">
        {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '1000, 1400, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
      </picture>
    {%- else -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '800, 1000, 1400, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
    {%- endif -%}
  {%- else -%}
    <img src="{{ 'hero.jpg' | asset_url }}" alt="After Nine rope cap resting on a fairway at dusk" width="1800" height="2400" fetchpriority="high">
  {%- endif -%}

  <div class="hero__meta">
    {%- if section.settings.show_clock -%}
      <span class="hero__place">{{ settings.clock_place | escape }} &nbsp;·&nbsp; <span data-clock></span></span>
    {%- else -%}
      <span></span>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="hero__link">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the built-in dusk fairway photo." },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone image (optional)", "info": "A portrait image for phones." },
    { "type": "range", "id": "focal_x", "label": "Focus left–right", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y", "label": "Focus top–bottom", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 34 },
    { "type": "checkbox", "id": "show_clock", "label": "Show place and live time", "default": true },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Shop the collection" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
