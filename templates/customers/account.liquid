<section class="page">
  <h1 class="page__title">Account</h1>
  <p><a href="{{ routes.account_logout_url }}" class="link-line">Log out</a></p>
  <h2 class="footer__h stack-gap">Orders</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table class="table">
        <thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th></tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%-d %b %Y' }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p class="muted">No orders yet.</p>
    {%- endif -%}
  {%- endpaginate -%}
  <h2 class="footer__h stack-gap">Address</h2>
  {%- if customer.default_address -%}
    <p>{{ customer.default_address | format_address }}</p>
  {%- endif -%}
  <p><a href="{{ routes.account_addresses_url }}" class="link-line">Manage addresses ({{ customer.addresses_count }})</a></p>
</section>
